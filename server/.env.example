# Copy this file to `.env` (same folder) and fill in your values.
# NEVER commit the real .env file. It is listed in .gitignore.

# Get a key at https://aistudio.google.com/apikey . Leave empty to run in retrieval-only mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name. Change it if Google retires or renames this model.
GEMINI_MODEL=gemini-2.5-flash

# Sentence Transformers model (downloaded on first use; needs internet once).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum PDF upload size in megabytes.
MAX_UPLOAD_MB=20

# Chunking (characters) and retrieval settings.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Minimum similarity (0-1) for a chunk to count as evidence. Tune this with your own documents.
MIN_RELEVANCE_SCORE=0.30

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded PDFs, the ChromaDB database and counters are stored.
EVIDENCEAI_DATA_DIR=data
